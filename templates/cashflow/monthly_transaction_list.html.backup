        <!-- Operational Expenses -->
        <h6 class="mt-4 mb-2"><strong><i class="fas fa-file-invoice-dollar text-danger"></i> Operational Expenses</strong></h6>
        {% if expenses %}
        <div class="table-responsive">
            <table class="breakdown-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Vendor</th>
                        <th>Memo</th>
                        <th class="text-right">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    {% for exp in expenses %}
                    <tr>
                        <td><i class="far fa-calendar"></i> {{ exp.date|date:"M d, Y" }}</td>
                        <td><span class="badge badge-warning">{{ exp.category.name }}</span></td>
                        <td>{{ exp.vendor|default:"-" }}</td>
                        <td>{{ exp.memo|truncatewords:10 }}</td>
                        <td class="text-right text-danger"><strong>₱{{ exp.amount|floatformat:2|intcomma }}</strong></td>
                    </tr>
                    {% endfor %}
                    <tr style="background: #f8f9fa; font-weight: bold;">
                        <td colspan="4" class="text-right">Total Operational:</td>
                        <td class="text-right text-danger">₱{{ summary.expenses_operational|floatformat:2|intcomma }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
        
        <!-- Pagination for Expenses -->
        {% if expenses.has_other_pages %}
        <div class="pagination-wrapper">
            <div class="pagination-info">
                <i class="fas fa-info-circle"></i> 
                Showing <strong>{{ expenses.start_index }}</strong> to <strong>{{ expenses.end_index }}</strong> of <strong>{{ expenses.paginator.count }}</strong> expenses
            </div>
            <nav>
                <ul class="pagination">
                    {% if expenses.has_previous %}
                    <li class="page-item">
                        <a class="page-link" href="?year={{ year }}&month={{ month }}&search={{ search_query }}&filter_type={{ filter_type }}&per_page={{ per_page }}&expenses_page={{ expenses.previous_page_number }}">
                            <i class="fas fa-chevron-left"></i> Previous
                        </a>
                    </li>
                    {% else %}
                    <li class="page-item disabled"><span class="page-link"><i class="fas fa-chevron-left"></i> Previous</span></li>
                    {% endif %}
                    
                    {% for num in expenses.paginator.page_range %}
                        {% if expenses.number == num %}
                        <li class="page-item active"><span class="page-link">{{ num }}</span></li>
                        {% elif num > expenses.number|add:'-3' and num < expenses.number|add:'3' %}
