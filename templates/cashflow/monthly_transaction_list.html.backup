                            <a class="page-link" href="?year={{ year }}&month={{ month }}&search={{ search_query }}&filter_type={{ filter_type }}&per_page={{ per_page }}&expenses_page={{ num }}">{{ num }}</a>
                        </li>
                        {% endif %}
                    {% endfor %}
                    
                    {% if expenses.has_next %}
                    <li class="page-item">
                        <a class="page-link" href="?year={{ year }}&month={{ month }}&search={{ search_query }}&filter_type={{ filter_type }}&per_page={{ per_page }}&expenses_page={{ expenses.next_page_number }}">
                            Next <i class="fas fa-chevron-right"></i>
                        </a>
                    </li>
                    {% else %}
                    <li class="page-item disabled"><span class="page-link">Next <i class="fas fa-chevron-right"></i></span></li>
                    {% endif %}
                </ul>
            </nav>
        </div>
        {% endif %}
        {% else %}
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No operational expenses found for this period.
        </div>
        {% endif %}

        <!-- Other Cash Out -->
        <h6 class="mt-4 mb-2"><strong><i class="fas fa-money-bill-wave text-danger"></i> Other Cash Out</strong></h6>
        {% if cash_out_txns %}
        <div class="table-responsive">
            <table class="breakdown-table">
                <thead>
                    <tr>
                        <th>Transaction #</th>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Reason</th>
                        <th class="text-right">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    {% for txn in cash_out_txns %}
                    <tr>
                        <td><a href="{% url 'cashflow:cashflow_detail' txn.pk %}" class="text-primary"><strong>{{ txn.transaction_number }}</strong></a></td>
                        <td><i class="far fa-calendar"></i> {{ txn.transaction_date|date:"M d, Y" }}</td>
                        <td><span class="badge badge-secondary">{{ txn.get_category_display }}</span></td>
                        <td>{{ txn.reason }}</td>
                        <td class="text-right text-danger"><strong>₱{{ txn.amount|floatformat:2|intcomma }}</strong></td>
                    </tr>
                    {% endfor %}
                    <tr style="background: #f8f9fa; font-weight: bold;">
                        <td colspan="4" class="text-right">Total Other Cash Out:</td>
                        <td class="text-right text-danger">₱{{ summary.expenses_other|floatformat:2|intcomma }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
        
        <!-- Pagination for Cash Out -->
        {% if cash_out_txns.has_other_pages %}
        <div class="pagination-wrapper">
            <div class="pagination-info">
                <i class="fas fa-info-circle"></i> 
                Showing <strong>{{ cash_out_txns.start_index }}</strong> to <strong>{{ cash_out_txns.end_index }}</strong> of <strong>{{ cash_out_txns.paginator.count }}</strong> transactions
            </div>
            <nav>
                <ul class="pagination">
                    {% if cash_out_txns.has_previous %}
                    <li class="page-item">
                        <a class="page-link" href="?year={{ year }}&month={{ month }}&search={{ search_query }}&filter_type={{ filter_type }}&per_page={{ per_page }}&cash_out_page={{ cash_out_txns.previous_page_number }}">
                            <i class="fas fa-chevron-left"></i> Previous
                        </a>
                    </li>
                    {% else %}
                    <li class="page-item disabled"><span class="page-link"><i class="fas fa-chevron-left"></i> Previous</span></li>
                    {% endif %}
                    
                    {% for num in cash_out_txns.paginator.page_range %}
                        {% if cash_out_txns.number == num %}
                        <li class="page-item active"><span class="page-link">{{ num }}</span></li>
                        {% elif num > cash_out_txns.number|add:'-3' and num < cash_out_txns.number|add:'3' %}
                        <li class="page-item">
                            <a class="page-link" href="?year={{ year }}&month={{ month }}&search={{ search_query }}&filter_type={{ filter_type }}&per_page={{ per_page }}&cash_out_page={{ num }}">{{ num }}</a>
                        </li>
                        {% endif %}
                    {% endfor %}
                    
                    {% if cash_out_txns.has_next %}
                    <li class="page-item">
                        <a class="page-link" href="?year={{ year }}&month={{ month }}&search={{ search_query }}&filter_type={{ filter_type }}&per_page={{ per_page }}&cash_out_page={{ cash_out_txns.next_page_number }}">
                            Next <i class="fas fa-chevron-right"></i>
                        </a>
                    </li>
                    {% else %}
                    <li class="page-item disabled"><span class="page-link">Next <i class="fas fa-chevron-right"></i></span></li>
                    {% endif %}
                </ul>
            </nav>
        </div>
        {% endif %}
        {% else %}
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No other cash-out transactions found for this period.
        </div>
        {% endif %}
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="text-center mb-4">
        <a href="{% url 'cashflow:monthly_dashboard' %}" class="btn btn-primary btn-lg">
            <i class="fas fa-chart-bar"></i> View Dashboard
        </a>
        <a href="#" data-modal-url="{% url 'cashflow:cashflow_create' %}" class="btn btn-success btn-lg">
            <i class="fas fa-plus"></i> New Transaction
        </a>
        <a href="#top" class="btn btn-outline-secondary btn-lg">
            <i class="fas fa-arrow-up"></i> Back to Top
        </a>
    </div>
</div>

<script>
// Toggle collapsible sections
function toggleSection(sectionId) {
    const section = document.getElementById(sectionId);
    const toggle = event.currentTarget;
    const icon = toggle.querySelector('.fa-chevron-down');
    
    if (section.style.display === 'none') {
        section.style.display = 'block';
        icon.style.transform = 'rotate(0deg)';
        toggle.classList.remove('collapsed');
    } else {
        section.style.display = 'none';
        icon.style.transform = 'rotate(-90deg)';
        toggle.classList.add('collapsed');
    }
}

// Auto-submit form on filter change
document.getElementById('filter_type').addEventListener('change', function() {
    document.getElementById('filterForm').submit();
});

document.getElementById('per_page').addEventListener('change', function() {
    document.getElementById('filterForm').submit();
});

// Smooth scroll to top
document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
            target.scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });
        }
    });
});

// Add loading indicator on form submit
document.getElementById('filterForm').addEventListener('submit', function() {
    const overlay = document.createElement('div');
    overlay.className = 'loading-overlay';
    overlay.style.display = 'flex';
    overlay.innerHTML = '<div class="loading-spinner"></div>';
    document.body.appendChild(overlay);
});

// Highlight search terms
const searchQuery = "{{ search_query|escapejs }}";
if (searchQuery) {
    const regex = new RegExp(`(${searchQuery})`, 'gi');
    document.querySelectorAll('.breakdown-table td').forEach(cell => {
        if (cell.textContent.match(regex)) {
            cell.innerHTML = cell.innerHTML.replace(regex, '<mark>$1</mark>');
        }
    });
}
</script>
{% endblock %}
