                            <td class="text-right text-danger"><strong>₱{{ grn.amount|floatformat:2|intcomma }}</strong></td>
                        </tr>
                        {% endfor %}
                        <tr style="background: #f8f9fa; font-weight: bold;">
                            <td colspan="3" class="text-right">Total Procurement:</td>
                            <td class="text-right text-danger">₱{{ summary.expenses_procurement|floatformat:2|intcomma }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        
        <!-- Pagination for Procurement -->
        {% if procurement_breakdown.has_other_pages %}
        <div class="pagination-wrapper">
            <div class="pagination-info">
                <i class="fas fa-info-circle"></i> 
                Showing <strong>{{ procurement_breakdown.start_index }}</strong> to <strong>{{ procurement_breakdown.end_index }}</strong> of <strong>{{ procurement_breakdown.paginator.count }}</strong> GRNs
            </div>
            <nav>
                <ul class="pagination">
                    {% if procurement_breakdown.has_previous %}
                    <li class="page-item">
                        <a class="page-link" href="?year={{ year }}&month={{ month }}&search={{ search_query }}&filter_type={{ filter_type }}&per_page={{ per_page }}&procurement_page={{ procurement_breakdown.previous_page_number }}">
                            <i class="fas fa-chevron-left"></i> Previous
                        </a>
                    </li>
                    {% else %}
                    <li class="page-item disabled"><span class="page-link"><i class="fas fa-chevron-left"></i> Previous</span></li>
                    {% endif %}
                    
                    {% for num in procurement_breakdown.paginator.page_range %}
                        {% if procurement_breakdown.number == num %}
                        <li class="page-item active"><span class="page-link">{{ num }}</span></li>
                        {% elif num > procurement_breakdown.number|add:'-3' and num < procurement_breakdown.number|add:'3' %}
                        <li class="page-item">
                            <a class="page-link" href="?year={{ year }}&month={{ month }}&search={{ search_query }}&filter_type={{ filter_type }}&per_page={{ per_page }}&procurement_page={{ num }}">{{ num }}</a>
                        </li>
                        {% endif %}
                    {% endfor %}
                    
                    {% if procurement_breakdown.has_next %}
                    <li class="page-item">
                        <a class="page-link" href="?year={{ year }}&month={{ month }}&search={{ search_query }}&filter_type={{ filter_type }}&per_page={{ per_page }}&procurement_page={{ procurement_breakdown.next_page_number }}">
                            Next <i class="fas fa-chevron-right"></i>
                        </a>
                    </li>
                    {% else %}
                    <li class="page-item disabled"><span class="page-link">Next <i class="fas fa-chevron-right"></i></span></li>
                    {% endif %}
