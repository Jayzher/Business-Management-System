/* Base light theme. Structured so a future app_dark.qss can swap by
   keeping the same selectors. */

QMainWindow,
QDialog,
QWidget {
    background-color: #f8fafc;
    color: #111827;
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e5e7eb;
    padding: 2px 6px;
}
QMenuBar::item {
    padding: 4px 10px;
    background: transparent;
}
QMenuBar::item:selected {
    background: #e0e7ff;
    border-radius: 4px;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    padding: 4px;
}
QMenu::item {
    padding: 6px 18px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #e0e7ff;
}

QToolBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e5e7eb;
    padding: 4px;
    spacing: 4px;
}
QToolBar::separator {
    background: #e5e7eb;
    width: 1px;
    margin: 4px 6px;
}

QStatusBar {
    background-color: #ffffff;
    border-top: 1px solid #e5e7eb;
    color: #374151;
}

QPushButton {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 5px 12px;
    color: #111827;
}
QPushButton:hover {
    background-color: #f3f4f6;
    border-color: #9ca3af;
}
QPushButton:pressed {
    background-color: #e5e7eb;
}
QPushButton:disabled {
    color: #9ca3af;
    background-color: #f9fafb;
    border-color: #e5e7eb;
}

QLineEdit, QComboBox {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 4px 8px;
    selection-background-color: #c7d2fe;
}
QLineEdit:focus, QComboBox:focus {
    border-color: #6366f1;
}

QCheckBox {
    spacing: 6px;
}

QProgressBar {
    background-color: #e5e7eb;
    border: none;
    border-radius: 4px;
    text-align: center;
}
QProgressBar::chunk {
    background-color: #6366f1;
    border-radius: 4px;
}

QWidget#SplashScreen {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 8px;
}
QLabel#SplashTitle {
    font-size: 18px;
    font-weight: 600;
    color: #111827;
}
QLabel#SplashStatus {
    font-size: 12px;
    color: #4b5563;
}
